# Copie para as variáveis da Vercel (Settings > Environment Variables). Nunca coloque valores reais no código.
NEXT_PUBLIC_SUPABASE_URL=          # Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # mesma tela: chave "anon" / publishable
SUPABASE_SERVICE_ROLE_KEY=         # mesma tela: chave "service_role" / secret (só servidor)
ASAAS_API_KEY=                     # Asaas > Integrações > Chave de API
ASAAS_API_URL=https://api-sandbox.asaas.com/v3   # em produção: https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=               # invente um texto longo; use o mesmo ao criar o webhook no Asaas
